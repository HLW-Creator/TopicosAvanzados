interface media
{
    val title: String
    fun play()
}

class audio(override val title: String, val composer: String): media
{
    override fun play()
    {
        println("Playing audio: $title, composed by $composer")
    }
}

fun main() {
    val audio = audio("Symphony No. 5", "Beethoven")
    audio.play()
   // Playing audio: Symphony No. 5, composed by Beethoven
}
