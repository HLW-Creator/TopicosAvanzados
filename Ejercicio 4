fun validateStock(requested: Int?, available: Int?): Int {
    val vrequested = requested ?: return -1
    val vavailable = available ?: return -1
    if(vrequested<0) return -1
    if(vrequested>vavailable) return -1
    return vrequested
}

fun main() {
    println(validateStock(5,10))
    // 5
    println(validateStock(null,10))
    // -1
    println(validateStock(-2,10))
    // -1
}
